# GitHub Models token with the "models: read" permission (fine-grained PAT).
# Create one at: https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=

# Optional: which GitHub Models model to use.
MODEL_NAME=openai/gpt-4o-mini

# A classic GitHub PAT with the "repo" scope, used to authenticate to the
# hosted GitHub MCP server for code/repo search. This can be a *different*
# token from GITHUB_MODELS_TOKEN since it needs a different permission type.
# Create one at: https://github.com/settings/tokens
GITHUB_MCP_TOKEN=

# Exa API key for web search (docs, blog posts, Stack Overflow, etc).
# Get one at: https://exa.ai
EXA_API_KEY=
